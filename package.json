{
  "name": "bee-skills",
  "version": "0.2.0",
  "private": true,
  "description": "bee: declare the agent skills a project runs on (harness.json), pin them (harness.lock), install them anywhere.",
  "type": "module",
  "bin": {
    "bee": "dist/bee.mjs"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "registry.json"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/bee.mjs --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
